# FinePrint — Environment Variables
# Configured for prototype/testing mode

LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
EMBED_MODEL=text-embedding-3-small

# Set to 1 for development without API keys (uses fixture data / deterministic mock embeddings)
MOCK_LLM=1

# Tesseract OCR path (Windows)
TESSERACT_CMD=D:\Extra application\Tesseract-OCR\tesseract.exe
